{
  "name": "3x-ui-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "3x-ui panel frontend (React 19 + Ant Design 6 + Vite 8).",
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run gen:api && vite build",
    "preview": "vite preview",
    "lint": "oxlint src tools",
    "lint:fix": "oxlint --fix src tools",
    "lint:deprecated": "oxlint --type-aware -A all -D typescript/no-deprecated src",
    "format": "oxfmt src tools",
    "format:check": "oxfmt --check src tools",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "gen": "npm run gen:zod && npm run gen:api",
    "gen:api": "node scripts/build-openapi.mjs",
    "gen:zod": "cd .. && go run ./tools/openapigen",
    "prepare": "cd .. && husky frontend/.husky || true"
  },
  "lint-staged": {
    "src/{api,components,entries,hooks,i18n,layouts,lib,models,pages,schemas,test,utils}/**/*.{ts,tsx}": [
      "oxfmt",
      "oxlint --fix"
    ]
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.4",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.9.1",
    "@monaco-editor/react": "^4.7.0",
    "@noble/hashes": "^2.4.0",
    "@radix-ui/react-accordion": "^1.2.14",
    "@radix-ui/react-alert-dialog": "^1.1.17",
    "@radix-ui/react-avatar": "^1.2.0",
    "@radix-ui/react-checkbox": "^1.3.5",
    "@radix-ui/react-collapsible": "^1.1.14",
    "@radix-ui/react-dialog": "^1.1.17",
    "@radix-ui/react-dropdown-menu": "^2.1.18",
    "@radix-ui/react-hover-card": "^1.1.17",
    "@radix-ui/react-label": "^2.1.10",
    "@radix-ui/react-popover": "^1.1.17",
    "@radix-ui/react-progress": "^1.1.10",
    "@radix-ui/react-radio-group": "^1.4.1",
    "@radix-ui/react-scroll-area": "^1.2.12",
    "@radix-ui/react-select": "^2.3.1",
    "@radix-ui/react-separator": "^1.1.10",
    "@radix-ui/react-slot": "^1.3.0",
    "@radix-ui/react-switch": "^1.3.1",
    "@radix-ui/react-tabs": "^1.1.15",
    "@radix-ui/react-toast": "^1.2.17",
    "@radix-ui/react-toggle": "^1.1.12",
    "@radix-ui/react-toggle-group": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.10",
    "@tailwindcss/vite": "^4.3.1",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-query-devtools": "^5.102.8",
    "@tanstack/react-table": "^8.21.3",
    "ace-builds": "^1.44.0",
    "antd": "^6.6.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "codemirror": "^6.0.2",
    "date-fns": "^4.4.0",
    "dayjs": "^1.11.23",
    "embla-carousel-react": "^8.6.0",
    "es-toolkit": "^1.49.0",
    "i18next": "^26.4.2",
    "lucide-react": "^0.577.0",
    "otpauth": "^9.5.2",
    "persian-calendar-suite": "^1.5.6",
    "qs": "^6.15.3",
    "react": "^19.3.0",
    "react-ace": "^14.0.1",
    "react-day-picker": "^9.7.0",
    "react-dom": "^19.3.0",
    "react-github-btn": "^1.4.0",
    "react-hook-form": "^7.88.0",
    "react-i18next": "^17.0.14",
    "react-router": "^8.3.1",
    "react-top-loading-bar": "^3.0.2",
    "recharts": "^3.9.0",
    "sonner": "^2.0.7",
    "swagger-ui-react": "^5.32.15",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.1",
    "tailwindcss-animate": "^1.0.7",
    "uplot": "^1.6.32",
    "vaul": "^1.1.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/addon-vitest": "^10.6.0",
    "@storybook/react-vite": "^10.6.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/swagger-ui-react": "^5.18.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/browser-playwright": "5.0.0",
    "@vitest/coverage-v8": "^5.0.0",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.5.1",
    "msw": "^2.15.0",
    "oxfmt": "0.68.0",
    "oxlint": "1.83.0",
    "oxlint-tsgolint": "^7.0.2001",
    "playwright": "^1.63.0",
    "storybook": "^10.6.0",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "dompurify": "^3.4.11",
    "react-copy-to-clipboard": "^5.1.1",
    "react-inspector": "^9.0.0",
    "react-debounce-input": {
      "react": "^19.0.0"
    },
    "swagger-ui-react": {
      "js-yaml": "^4.3.2",
      "brace-expansion": "^5.0.9"
    },
    "@typeschema/valibot": {
      "valibot": "^1.1.0"
    },
    "@storybook/addon-vitest": {
      "vitest": "^5.0.0",
      "@vitest/browser-playwright": "5.0.0",
      "@vitest/browser": "5.0.0"
    }
  },
  "allowScripts": {
    "@scarf/scarf": false,
    "@tree-sitter-grammars/tree-sitter-yaml": false,
    "tree-sitter": false,
    "core-js-pure": false,
    "tree-sitter-json": false,
    "msw": false,
    "esbuild": false
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}